---
import { useLocale, urls, siteTitle, config } from '../src/runtime/index.ts';
interface Props { lang: string }
const { lang } = Astro.props;
const { t, digits } = useLocale(lang);
const year = new Date().getUTCFullYear();
const footer = config.site.i18n?.[lang]?.footer ?? config.site.footer;
---
<footer class="pw-footer">
  <p>© {digits(year)} {siteTitle(lang)} · <a href={urls.feed(lang, 'rss.xml')}>{t('feed.rss')}</a> · {footer ? <span set:html={footer} /> : <a href="https://github.com/paperwhite-blog/core" rel="noopener">{t('footer.poweredBy')}</a>}</p>
</footer>
