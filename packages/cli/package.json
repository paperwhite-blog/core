{
  "name": "paperwhite",
  "version": "0.1.0",
  "description": "PaperWhite CLI: Obsidian in, Lighthouse 100 out.",
  "type": "module",
  "license": "MIT",
  "bin": { "paperwhite": "./bin/paperwhite.mjs" },
  "files": ["bin", "src", "dist", "templates"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --external @paperwhite/core --external astro",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@paperwhite/core": "workspace:*",
    "citty": "^0.2.2",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "astro": "^7.3.5",
    "tsup": "^8.5.1"
  }
}
