{
  "name": "paperwhite-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "paperwhite dev",
    "build": "paperwhite build",
    "preview": "paperwhite preview",
    "check": "paperwhite check",
    "new": "paperwhite new",
    "docs:dev": "paperwhite dev --site docs",
    "docs:build": "paperwhite build --site docs",
    "test": "pnpm --filter @paperwhite/core test",
    "test:watch": "pnpm --filter @paperwhite/core test:watch",
    "typecheck": "pnpm --filter @paperwhite/core typecheck",
    "e2e": "playwright test -c dev/e2e/playwright.config.ts",
    "lhci": "lhci autorun --config=dev/lighthouserc.cjs",
    "bench": "pnpm --filter paperwhite-bench run bench",
    "check:audit": "node dev/assert-audit.mjs",
    "link-cli": "node dev/link-cli.mjs",
    "unlink-cli": "node dev/link-cli.mjs --unlink"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@paperwhite/core": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  },
  "paperwhite": {
    "site": "dev/fixture-site"
  }
}
