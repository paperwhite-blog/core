{
  "name": "paperwhite-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "paperwhite dev",
    "build": "paperwhite build",
    "preview": "paperwhite preview",
    "check": "paperwhite check",
    "new": "paperwhite new",
    "docs:dev": "paperwhite dev --site docs",
    "docs:build": "paperwhite build --site docs",
    "site:dev": "paperwhite dev",
    "site:build": "paperwhite build",
    "link-cli": "node scripts/link-cli.mjs",
    "unlink-cli": "node scripts/link-cli.mjs --unlink",
    "build:packages": "pnpm --filter paperwhite run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @paperwhite/core exec tsc -p tsconfig.json && pnpm --filter paperwhite exec tsc -p tsconfig.json",
    "e2e": "playwright test",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "bench": "pnpm --filter paperwhite-bench run bench",
    "check:audit": "node scripts/assert-audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "paperwhite": "workspace:*"
  },
  "paperwhite": {
    "site": "examples/site"
  }
}
