{
  "name": "paperwhite",
  "description": "Obsidian in, Lighthouse 100 out. Clone, write Markdown, publish.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "paperwhite dev",
    "build": "paperwhite build",
    "preview": "paperwhite preview",
    "check": "paperwhite check",
    "new": "paperwhite new",
    "add": "paperwhite add",
    "update": "paperwhite update",
    "test": "pnpm --filter @paperwhite/core test",
    "test:watch": "pnpm --filter @paperwhite/core test:watch",
    "typecheck": "pnpm --filter @paperwhite/core typecheck",
    "fixture:build": "paperwhite build --site dev/fixture-site",
    "fixture:dev": "paperwhite dev --site dev/fixture-site",
    "e2e": "playwright test -c dev/e2e/playwright.config.ts",
    "lhci": "lhci autorun --config=dev/lighthouserc.cjs",
    "bench": "pnpm --filter paperwhite-bench run bench",
    "check:audit": "node dev/assert-audit.mjs",
    "link-cli": "node dev/link-cli.mjs",
    "unlink-cli": "node dev/link-cli.mjs --unlink"
  },
  "dependencies": {
    "@paperwhite/core": "workspace:*",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  }
}
