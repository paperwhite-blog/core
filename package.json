{
  "name": "paperwhite-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./themes/** --filter ./plugins/** run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @paperwhite/core exec tsc -p tsconfig.json && pnpm --filter paperwhite exec tsc -p tsconfig.json",
    "site:build": "pnpm --filter example-site run build",
    "site:dev": "pnpm --filter example-site run dev",
    "docs:build": "pnpm --filter paperwhite-docs run build",
    "e2e": "playwright test",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "bench": "pnpm --filter paperwhite-bench run bench",
    "check:audit": "node scripts/assert-audit.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
